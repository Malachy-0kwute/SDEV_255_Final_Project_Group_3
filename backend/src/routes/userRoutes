});

// enroll in courses
router.put('/course/enroll/:id', async (req, res) => {

  const authHeader = req.headers.authorization;

  if (!authHeader) {
    return res.status(401).json({ error: 'Unauthorized. No token provided'});
  }

  try {

    const token = authHeader.split(' ')[1];

    const decodedToken = jwt.decode(token, secret);

    const userRole = await User.findOne({_id: req.params.id});

    // only register students for courses
    if (userRole.isStudent == false) {
      return res.status(401).json({ error: 'Only students can register for courses'});
    }

    const user = await User.findOneAndUpdate({_id: req.params.id}, req.body);

    if (!user) {
      return res.status(404).json({error: 'User not found'});
    }

    res.status(201).json({message: 'Courses added successfully', userId: user._id});

  } catch (error) {
      res.status(500).json({error: 'Internal server error',  message: error.message });
  }
});

module.exports = router